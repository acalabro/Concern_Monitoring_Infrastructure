FROM maven:3.9-eclipse-temurin-17

WORKDIR /app

# Crea directory logs
RUN mkdir -p /app/logs && chmod 777 /app/logs

COPY pom.xml .
COPY src ./src

RUN mvn clean compile

EXPOSE 8181 61616

ENV MYSQL_HOST=mysql \
    MYSQL_PORT=3306 \
    MYSQL_DATABASE=eventdb \
    MYSQL_USER=concern \
    MYSQL_PASSWORD=un53cur3!!

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8181/api/health || exit 1

ENTRYPOINT ["mvn", "exec:java", "-Dexec.mainClass=it.cnr.isti.labsedc.concern.rest.Main"]
